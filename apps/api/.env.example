# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Google Gemini research analyzer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_ANALYSIS_CHARACTERS=120000
GEMINI_MAX_INPUT_CHARS=60000
GEMINI_CHUNK_CHARS=60000
GEMINI_CHUNK_OVERLAP_CHARS=500
GEMINI_TIMEOUT_SECONDS=45

# Scholarly metadata providers.
SCIENTOMETRIC_ENGINE_PATH=
CROSSREF_MAILTO=
OPENALEX_EMAIL=
ELSEVIER_API_KEY=
MAX_SOURCE_EVIDENCE_CHARACTERS=6000

# Bounded public repository inspection.
ARTIFACT_REQUEST_TIMEOUT_SECONDS=10
MAX_REPOSITORY_FILES=200
MAX_REPOSITORY_DIRECTORY_DEPTH=2
MAX_REPOSITORY_README_CHARS=40000
MAX_REPOSITORY_METADATA_REQUESTS=6
MAX_REPOSITORY_CONTENT_REQUESTS=4
