# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Google Gemini Research Analyzer configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Maximum total selected context retained across all Gemini chunks.
MAX_ANALYSIS_CHARACTERS=120000

# Maximum characters in one Gemini request, semantic chunk target, and small
# paragraph overlap. Character counts are not token counts.
GEMINI_MAX_INPUT_CHARS=45000
GEMINI_CHUNK_CHARS=40000
GEMINI_CHUNK_OVERLAP_CHARS=500

# Provider request timeout in seconds.
GEMINI_TIMEOUT_SECONDS=120

# Scientometric engine integration. The adapter auto-discovers the checked-in
# Scientometric-Audit-Studio-main directory when this is blank.
SCIENTOMETRIC_ENGINE_PATH=

# Polite-pool contact information for free scholarly metadata providers.
CROSSREF_MAILTO=
OPENALEX_EMAIL=

# Optional paid Scopus provider. Crossref and OpenAlex work without this key.
ELSEVIER_API_KEY=
MAX_SOURCE_EVIDENCE_CHARACTERS=6000
ARTIFACT_REQUEST_TIMEOUT_SECONDS=10

# STEP 3B bounded public repository metadata/documentation inspection.
MAX_REPOSITORY_FILES=200
MAX_REPOSITORY_DIRECTORY_DEPTH=2
MAX_REPOSITORY_README_CHARS=40000
MAX_REPOSITORY_METADATA_REQUESTS=6
